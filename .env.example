# Optional. Overrides where submitted leads are POSTed as JSON.
# Leave unset and leads go to the default Zapier catch hook baked into
# app/api/lead/route.ts. Set this to point a deployment at a different
# destination (staging, a replacement Zap, a CRM endpoint).
LEAD_WEBHOOK_URL=

# --- Meta Conversions API (server-side "Lead" events) ---
# Both of these must be set or no events are sent. Never commit real values.
# META_PIXEL_ID is the Pixel / dataset ID from Events Manager → Data sources.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# Optional. Routes events to Events Manager → Test events instead of production.
META_TEST_EVENT_CODE=

# Optional. Graph API version to post to (defaults to v26.0).
META_GRAPH_API_VERSION=

# Optional. "true" enables Limited Data Use. The country/state codes default to
# 0, which asks Meta to geolocate the user and apply the right state's rules.
META_CAPI_LDU=
META_CAPI_LDU_COUNTRY=
META_CAPI_LDU_STATE=

# Optional. "true" marks every event as opted out of ad targeting use.
META_CAPI_OPT_OUT=
